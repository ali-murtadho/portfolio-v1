# Salin file ini menjadi .env.local lalu isi nilainya.

# Connection string PostgreSQL (Neon, Supabase, Vercel Postgres, atau Postgres lokal).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Password untuk login ke /admin.
ADMIN_PASSWORD=ganti-dengan-password-yang-kuat

# (Opsional) Secret untuk menandatangani cookie sesi. Jika kosong, ADMIN_PASSWORD yang dipakai.
ADMIN_SECRET=
